# Python environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw USGS pulls (regenerated by src/data/fetch_nwis.py) and derived tables
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated figures stay local by default; specific report figures are
# committed explicitly once selected.
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/faithfulness_distribution.png
!reports/figures/combined_distribution.png

# Credentials and secrets, especially the Typesafe API key
.env
*.env
secrets.yaml
*_secret*
*.key

# Tooling
.pytest_cache/
.DS_Store
